# EditorConfig — root formatting baseline (Projektets utvecklingsmetodik B2 SKA 1).
# Line endings mirror .gitattributes: LF everywhere except PowerShell (CRLF on Windows).
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
