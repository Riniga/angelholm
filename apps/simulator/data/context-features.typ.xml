<!--
Trimmed polyconvert type file: only the water/natural/landuse polygonType entries from
SUMO's bundled osmPolyconvert.typ.xml (eclipse-sumo's data/typemap/ directory). Used with
the polyconvert "discard" option, which drops any OSM type NOT listed here (e.g.
buildings, amenities, shops) by default — verified for real, see
docs/architecture/decisions/ADR-008-polyconvert-for-context-features.md and
docs/plans/003-map-context-features.plan.md Phase 1.

Source: eclipse-sumo 1.27.1, data/typemap/osmPolyconvert.typ.xml (EPL-2.0 OR
GPL-2.0-or-later, approved for this project's use, docs/standards/dependencies.md,
ADR-006).
-->
<polygonTypes>
    <polygonType id="waterway"                name="water"       color=".71,.82,.82" layer="-4"/>
    <polygonType id="natural"                 name="natural"     color=".55,.77,.42" layer="-4"/>
    <polygonType id="natural.water"           name="water"       color=".71,.82,.82" layer="-4" fill="force"/>
    <polygonType id="natural.wetland"         name="water"       color=".71,.82,.82" layer="-4" fill="force"/>
    <polygonType id="natural.wood"            name="forest"      color=".55,.77,.42" layer="-4" fill="force"/>

    <polygonType id="landuse"                 name="landuse"     color=".76,.76,.51" layer="-3"/>
    <polygonType id="landuse.forest"          name="forest"      color=".55,.77,.42" layer="-3" fill="force"/>
    <polygonType id="landuse.park"            name="park"        color=".81,.96,.79" layer="-3" fill="force"/>
    <polygonType id="landuse.residential"     name="residential" color=".92,.92,.89" layer="-3" fill="force"/>
    <polygonType id="landuse.commercial"      name="commercial"  color=".82,.82,.80" layer="-3" fill="force"/>
    <polygonType id="landuse.industrial"      name="industrial"  color=".82,.82,.80" layer="-3" fill="force"/>
    <polygonType id="landuse.farm"            name="farm"        color=".95,.95,.80" layer="-3" fill="force"/>
    <polygonType id="landuse.village_green"   name="farm"        color=".95,.95,.80" layer="-3" fill="force"/>
</polygonTypes>
