# Shell scripts must always use LF line endings — CRLF breaks bash on Linux App Service
*.sh text eol=lf

# PowerShell scripts use CRLF on Windows (default)
*.ps1 text eol=crlf

# Standard text files — let Git normalise to LF in the repo, checkout as-is
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.env text eol=lf
*.csv text eol=lf
*.xml text eol=lf

# Binary files — never modify line endings
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.xlsx binary
