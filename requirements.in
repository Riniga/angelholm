# Source list for requirements-lock.txt
# (pip-compile --generate-hashes --no-annotate --no-header --output-file=requirements-lock.txt requirements.in).
# This is the dependency surface environment.yml's `pip:` block lists directly;
# environment.yml just points at the compiled lock (`-r requirements-lock.txt`).
# Conda-managed dependencies (python, pytest, ...) are not here — they are pinned
# directly in environment.yml. See docs/standards/dependencies.md.
#
# requirements-lock.txt IS committed in this project (generated once the environment name
# and this source list were real — see MVP-000). Note for anyone reusing this file as a
# template elsewhere: pip-compile defaults its output to `requirements.txt` (input stem +
# `.txt`) when `--output-file` is omitted — always pass it explicitly, or you'll silently
# generate the wrong filename (this project hit exactly that once; see MVP-000's context).
#
# To update: edit a range here, then re-run
#   pip-compile --generate-hashes --no-annotate --no-header --output-file=requirements-lock.txt requirements.in
# and commit both files together. CI fails if requirements-lock.txt drifts from this file.
# Prefer letting CI's own recompile (Linux, the actual deploy target) be authoritative over
# a local Windows recompile — Windows and Linux can silently resolve different transitive
# packages for the same requirements.in (see the example comment below); if CI's drift
# check fails after a local Windows edit, trust CI's diff over your own local output.

# Platform-conditional-package gotcha, hit for real (MVP-001 PR #3's CI, not a guess):
# `pytest` declares `colorama>=0.4 ; sys_platform == "win32"`. Compiling this file on
# Windows resolved that marker true and included colorama; CI's own Linux recompile
# resolves it false and drops it — a real diff, not a hash-ordering false alarm (see
# MVP-000/001's close-out notes for that separate, harmless kind of noise). Pinned
# explicitly and unconditionally below so both platforms agree, per this file's own
# standing guidance above.
colorama==0.4.6

# Ruff is pinned exactly — its formatter/lint output changes between minor versions. Keep
# it on the same version as `rev` in .pre-commit-config.yaml.
ruff==0.16.7
pre-commit>=3,<5
# docs/standards/testing.md and ci.yml's "Run tests" job both assume pytest-cov (`pytest
# --cov`), but nothing had actually added it as a dependency until now — a real gap that
# was masked by GAP-E2-CICHAIN failing that same CI job earlier, before the coverage step
# ever ran. Discovered by actually running `pytest --cov` locally (MVP-001 Phase 2), not by
# reading the config.
pytest-cov>=7.1.0,<8

# SUMO mobility simulation engine (MVP-001 — see docs/plans/001-first-traffic-simulator.plan.md
# and ADR-006). Pinned exactly, all three at the same version deliberately: `traci`/`sumolib`
# are thin Python APIs over the `eclipse-sumo` binaries and must match the engine version they
# talk to, not just satisfy a loose range. Note the real PyPI name is `eclipse-sumo` —
# conda-forge's own package literally called `sumo` is an unrelated, different project
# (ab-initio solid-state-physics plotting tools); do not install that one.
# Licence: dual EPL-2.0/GPL-2.0-or-later — approved by the project owner 2026-09-16, see
# docs/standards/dependencies.md's allow-list.
eclipse-sumo==1.27.1
traci==1.27.1
sumolib==1.27.1

# MVP-002 (docs/plans/002-extended-map-area.plan.md, ADR-007): polygon-based network
# clipping to the project owner's hand-drawn coverage outline, instead of a bounding box.
# shapely is a real runtime dependency of the `simulator` package (polygon representation
# and validation in `simulator.network.load_boundary_polygon`) — kept as a loose range like
# the project's other non-engine-coupled dependencies.
shapely>=2.0,<3
# numpy, opencv-python-headless and pillow are tooling-only: used once each by
# scripts/extract_coverage_outline.py (trace the hand-drawn outline in
# docs/architecture/mapoutline.png into GeoJSON, MVP-002) and
# scripts/convert_context_background.py (convert docs/architecture/map_plain.gif into the
# committed apps/simulator/data/context-background.png, MVP-003). Not imported by the
# `simulator` package itself — opencv's "headless" variant avoids pulling in GUI/video
# libraries this repo never uses. Licences: BSD-3-Clause / Apache Software License / MIT-CMU
# (Pillow — an MIT variant, approved by the project owner 2026-09-18) — see
# docs/standards/dependencies.md's allow-list.
numpy>=1.26,<3
opencv-python-headless>=4.9,<5
pillow>=10,<13

# MVP-003 (docs/plans/003-map-context-features.plan.md, ADR-008): places the project
# owner's own basemap image as a georeferenced sumo-gui background, so the covered area
# reads as recognisably Ängelholm without re-deriving water/land-use shapes from raw OSM
# data (an earlier approach using polyconvert let a large coastal water body leak in
# unclipped — polyconvert can only keep or discard a whole shape, never clip its geometry).
# pyproj: real simulator runtime dependency, used indirectly via sumolib's own
# convertLonLat2XY() (already an implicit requirement of sumolib for that functionality) to
# convert the background image's known corners into the network's coordinate system.
# Licence: MIT, already on this file's allowlist.
pyproj>=3.6,<4

# defusedxml: XXE-safe replacement for the stdlib xml.etree.ElementTree, used by
# simulator.context_features._read_net_bbox() to parse the committed network.net.xml.
# Not a response to a real exploit (network.net.xml is our own netconvert output, not
# untrusted external input) but a real, blocking CI finding — GitHub's "SAST" job (Semgrep,
# p/security-audit + p/owasp-top-ten) failed PR #6 on
# python.lang.security.use-defused-xml[-parse] for the plain xml.etree.ElementTree import.
# Licence: Python Software Foundation License, already on this file's allowlist.
defusedxml>=0.7,<0.8
